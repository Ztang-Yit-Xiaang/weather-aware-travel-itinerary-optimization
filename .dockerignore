# Deny by default: only the hosted runtime and frozen reference inputs travel.
**
!Dockerfile
!.dockerignore
!deploy/
!deploy/requirements-hosted.txt
!src/
!src/**
!scripts/
!scripts/run_hosted_app.py
!scripts/run_product_app.py
!configs/
!configs/default_trip_config.yaml
!configs/product_app_registry.json
!configs/product_route_delta.json
!configs/interest_regions/
!configs/interest_regions/**
!configs/product_poi_catalogs/
!configs/product_poi_catalogs/**
!runs/
!runs/e3ux-weather-repair-demo-v6/
!runs/e3ux-weather-repair-demo-v6/**
!runs/california-coast-product-demo-v2/
!runs/california-coast-product-demo-v2/**
!runs/california-coast-coherent-demo-v1/
!runs/california-coast-coherent-demo-v1/**
!results/
!results/route_deltas/
!results/route_deltas/product_pfeiffer_point_lobos_20260908_v1/
!results/route_deltas/product_pfeiffer_point_lobos_20260908_v1/**

# Apply these exclusions even inside an allowed source/reference directory.
**/.env
**/.env.*
**/.git
**/.venv
**/node_modules
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.product_app_state
**/sessions
**/conversations
**/workspaces
**/cache
**/raw_cache
**/docs
**/tests
**/*.ipynb
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.pmtiles
**/*.mbtiles
**/*.osm.pbf
**/*.osrm*
