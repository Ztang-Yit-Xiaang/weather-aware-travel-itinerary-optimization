# Copy to .env and replace every REPLACE value before preprocessing.
# Use an immutable registry digest, never :latest or an unpinned tag.
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend@sha256:REPLACE_WITH_APPROVED_IMAGE_DIGEST
OSRM_DATASET=california
OSRM_PORT=5000
OSM_PBF_URL=REPLACE_WITH_APPROVED_EXTRACT_URL
OSM_PBF_SHA256=REPLACE_WITH_PUBLISHED_OR_INDEPENDENTLY_VERIFIED_SHA256
OSRM_TEST_COORDS="-122.4783,37.8199;-122.1697,37.4275"

