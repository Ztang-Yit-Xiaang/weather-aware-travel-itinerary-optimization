# Copy this file to .env only after Atlas assets and an approved image are available.
# Never place MAPBOX_ATLAS_TOKEN, MAPBOX_ATLAS_LICENSE, or other credentials here.
ATLAS_NGINX_IMAGE=nginx@sha256:REPLACE_WITH_APPROVED_PLATFORM_DIGEST
ATLAS_ASSET_ROOT=C:/path/outside/the/repository/mapbox-atlas
PRODUCT_APP_ORIGIN=http://127.0.0.1:8127
