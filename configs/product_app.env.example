# Copy only the settings you need into the repository-root .env.local file.
# Keep .env.local untracked. Never commit API keys or Atlas licenses.

PRODUCT_COPILOT_ADAPTER=deterministic
OPENAI_COPILOT_MODEL=gpt-5.6-terra
OPENAI_COPILOT_TIMEOUT_SECONDS=30
OPENAI_COPILOT_HISTORY_MESSAGES=12
OPENAI_COPILOT_HISTORY_CHARACTERS=12000

PRODUCT_MAP_PROVIDER=maplibre_pmtiles
PRODUCT_MAP_BASE_URL=http://127.0.0.1:8080

# To enable the OpenAI adapter, set PRODUCT_COPILOT_ADAPTER=openai and add
# OPENAI_API_KEY to .env.local or the launching process environment. No secret
# value belongs in this example file.
