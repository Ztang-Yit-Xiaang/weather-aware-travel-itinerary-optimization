# Railway service variables. Fill these in its private dashboard; never commit values.
HOSTED_API_ORIGIN=https://your-service.up.railway.app
HOSTED_FRONTEND_ORIGIN=https://ztang-yit-xiaang.github.io
SUPABASE_URL=https://your-project.supabase.co
# Browser-safe publishable key (or legacy anon key), NEVER service_role or sb_secret.
SUPABASE_PUBLISHABLE_KEY=
HOSTED_OWNER_ID=
# Copy the IPv4 session-pooler connection string, port 5432. URL-encode password.
# Set sslmode=require at minimum; prefer verify-full with your configured CA.
DATABASE_URL=
ORS_API_KEY=
WEB_CONCURRENCY=1
PRODUCT_COPILOT_ADAPTER=deterministic
HOSTED_ENABLE_PAID_OPENAI=false
# Only after separate approval for billable model calls:
# PRODUCT_COPILOT_ADAPTER=openai
# HOSTED_ENABLE_PAID_OPENAI=true
# OPENAI_API_KEY=
# OPENAI_COPILOT_MODEL=your-available-model-id
